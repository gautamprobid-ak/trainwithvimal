# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# MySQL
MYSQL_DATABASE=trainwithvimal
MYSQL_USER=twv
MYSQL_PASSWORD=twv
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# CORS (Flutter web)
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=

# Email (console backend prints emails in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Train With Vimal <hello@trainwithvimal.app>
APP_LINK_BASE=https://app.trainwithvimal.app

# Firebase (push notifications + optional storage). Leave empty in dev: pushes are logged.
FIREBASE_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=
